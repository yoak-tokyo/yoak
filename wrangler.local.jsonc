// ローカル開発用の設定（`wrangler dev -c wrangler.local.jsonc`）。デプロイには使わない。
// 本番の wrangler.jsonc には、D1 が作られるまで d1_databases を書けないため、
// ローカル D1 を使うときだけこのファイルを使う。wrangler.jsonc を変えたらこちらも合わせる。
// 手順は docs/artifacts/setup.md の「ローカル開発」。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoak-corporate-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "vars": {
    "BASIC_AUTH_USER": "yoak",
    "NOTION_CONTACT_DATA_SOURCE_ID": "47ea414a-7a31-454c-9599-300e94cf1c06",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yoak-artifacts",
      // ローカル D1（.wrangler/state）にだけ使うので、ID はダミーでよい
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
